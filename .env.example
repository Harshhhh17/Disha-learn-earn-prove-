# ==============================================================================
# DISHA PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# PostgreSQL Database Connection (Managed PostgreSQL on DigitalOcean)
DATABASE_URL=postgresql://disha_admin:YourSecurePassword123@disha-db-do-user-12345.b.db.ondigitalocean.com:25060/disha_production?sslmode=require
DB_USER=disha_user
DB_PASSWORD=disha_secure_password_2026
DB_NAME=disha_production

# JWT Authentication
JWT_SECRET=replace_with_a_64_character_cryptographically_secure_random_string

# Master Admin Credentials
ADMIN_MASTER_PASSCODE=disha@2026
ADMIN_PASSWORD_HASH=$2a$10$gX3.vTz5FhQfV1r1q1.ZreF6F5sK1bXk4yC0Y3z4Q5y6e7r8t9u0

# Frontend URL (For CORS whitelist)
FRONTEND_URL=https://disha-learn-earn-prove.netlify.app

# Payment Gateway (Razorpay — Set PAYMENT_MODE=test for testing, live for production)
PAYMENT_MODE=test
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SMS / WhatsApp OTP Gateway (Fast2SMS / Twilio)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Redis Caching (Optional for multi-node sessions)
REDIS_URL=redis://default:disha_redis_secret@127.0.0.1:6379
