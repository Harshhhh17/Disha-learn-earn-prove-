# ==============================================================================
# Git Ignore Rules - Secret & Credential Safety
# ==============================================================================

# Environment files & secret configs (NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env

# Private keys, certificates, credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.keystore

# Node & Package Managers
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/

# Build & Bundler outputs
dist/
build/
.cache/
.parcel-cache/

# Operating System & IDE junk
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Server & Agent generated logs
*.log
.system_generated/
